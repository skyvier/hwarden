cabal-version:       2.4
name:                hwarden-agent
version:             0.1.0.0
build-type:          Simple

library
  hs-source-dirs:      src
  exposed-modules:
      Hwarden.Agent
    , Hwarden.Bitwarden
    , Hwarden.Logging
    , Hwarden.Runtime
    , Hwarden.Socket
    , Hwarden.Types
  other-modules:
      Hwarden.App
    , Hwarden.Bitwarden.Real
  default-language:    Haskell2010
  build-depends:
      aeson
    , base >=4.14 && <5
    , bytestring
    , directory
    , filepath
    , katip
    , network
    , process
    , QuickCheck
    , random
    , text
    , unix
    , uuid
    , unliftio
    , mtl
  ghc-options:         -Wall

executable hwarden-agent
  main-is:             Main.hs
  hs-source-dirs:      app
  default-language:    Haskell2010
  build-depends:
      base >=4.14 && <5
    , hwarden-agent
  ghc-options:         -Wall

test-suite hwarden-agent-test
  type:                exitcode-stdio-1.0
  main-is:             Main.hs
  hs-source-dirs:      test
  other-modules:
      Integration
  default-language:    Haskell2010
  build-tool-depends:  hwarden-agent:hwarden-agent
  build-depends:
      aeson
    , base >=4.14 && <5
    , bytestring
    , directory
    , hwarden-agent
    , filepath
    , katip
    , network
    , process
    , QuickCheck
    , random
    , tasty
    , tasty-hunit
    , tasty-quickcheck
    , text
    , unix
    , uuid
  ghc-options:         -Wall
