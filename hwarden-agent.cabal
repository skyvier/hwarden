cabal-version:       2.4
name:                hwarden-agent
version:             0.1.0.0
build-type:          Simple

executable hwarden-agent
  main-is:             Main.hs
  hs-source-dirs:      app
  other-modules:
      Hwarden.Agent
    , Hwarden.Socket
  default-language:    Haskell2010
  build-depends:
      aeson
    , base >=4.14 && <5
    , bytestring
    , directory
    , filepath
    , network
    , process
    , text
    , unix
  ghc-options:         -Wall

test-suite hwarden-agent-test
  type:                exitcode-stdio-1.0
  main-is:             Main.hs
  hs-source-dirs:
      test
    , app
  other-modules:
      Hwarden.Agent
    , Hwarden.Socket
  default-language:    Haskell2010
  build-tool-depends:  hwarden-agent:hwarden-agent
  build-depends:
      aeson
    , base >=4.14 && <5
    , bytestring
    , directory
    , filepath
    , network
    , process
    , tasty
    , tasty-hunit
    , text
    , unix
  ghc-options:         -Wall
