cabal-version:       2.4
name:                hwarden-agent
version:             0.1.0.0
build-type:          Simple

library
  hs-source-dirs:      src
  exposed-modules:
      Hwarden.Agent
    , Hwarden.App
    , Hwarden.Bitwarden
    , Hwarden.Cache
    , Hwarden.Logging
    , Hwarden.Response
    , Hwarden.Runtime
    , Hwarden.Socket
    , Hwarden.Types
    , Hwarden.Sanitize
  other-modules:
      Hwarden.Bitwarden.Real
  default-language:    Haskell2010
  build-depends:
      aeson
    , base >=4.14 && <5
    , bytestring
    , directory
    , filepath
    , first-class-families
    , katip
    , monad-time
    , network
    , process
    , QuickCheck
    , quickcheck-instances
    , random
    , text
    , time
    , unix
    , uuid
    , unliftio
    , mtl
  ghc-options:         -Wall

executable hwarden-agent
  main-is:             Main.hs
  hs-source-dirs:      app
  default-language:    Haskell2010
  build-depends:
      base >=4.14 && <5
    , hwarden-agent
  ghc-options:         -Wall

test-suite hwarden-agent-test
  type:                exitcode-stdio-1.0
  main-is:             Main.hs
  hs-source-dirs:      test
  other-modules:
      Test.Integration
    , Test.MockEnv
    , Test.Sanitization 
    , Test.Runtime
    , Test.Logging
    , Test.Cache
    , Test.StateMachine
    , Test.RequestHandler
    , Test.RequestHandler.Unlock
    , Test.RequestHandler.Status
    , Test.RequestHandler.ListItems
    , Test.RequestHandler.GetPassword
    , Test.Helpers
    , Test.Agent.Decide
    , Test.JsonCodec
  default-language:    Haskell2010
  build-tool-depends:  hwarden-agent:hwarden-agent
  build-depends:
      aeson
    , base >=4.14 && <5
    , bytestring
    , directory
    , hwarden-agent
    , filepath
    , first-class-families
    , katip
    , monad-time
    , mtl
    , network
    , process
    , QuickCheck
    , quickcheck-instances
    , random
    , tasty
    , tasty-hunit
    , tasty-quickcheck
    , text
    , time
    , unix
    , uuid
    , temporary
  ghc-options:         -Wall
