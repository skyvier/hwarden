#!/usr/bin/env bash

set -euo pipefail

SCRIPT_DIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
# shellcheck source=scripts/hwarden-lib
source "$SCRIPT_DIR/hwarden-lib"

[ $# -eq 1 ] || hwarden_fail "usage: $(basename "$0") ITEM_ID"

hwarden_require_x11_clipboard
"$SCRIPT_DIR/hwarden-ensure-unlocked"

password=$("$SCRIPT_DIR/hwarden-get-password" "$1")
printf '%s' "$password" | xclip -selection clipboard
