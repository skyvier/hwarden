#!/usr/bin/env bash

set -euo pipefail

SCRIPT_DIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
# shellcheck source=scripts/hwarden-lib
source "$SCRIPT_DIR/hwarden-lib"

[ $# -eq 1 ] || hwarden_fail "usage: $(basename "$0") EMAIL"

hwarden_require_cmd jq

email=$1
password=${HWARDEN_PASSWORD:-}

[ -n "$password" ] || hwarden_fail "HWARDEN_PASSWORD is required"

request_json=$(hwarden_unlock_request "$email" "$password")
response_json=$(hwarden_send_request "$request_json")

if ! hwarden_response_ok "$response_json"; then
  hwarden_fail "$(hwarden_response_error "$response_json")"
fi

printf '%s\n' "$(hwarden_status_value "$response_json")"
