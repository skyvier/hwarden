#!/usr/bin/env bash

set -euo pipefail

ROOT_DIR=$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)
cd "$ROOT_DIR"

cabal build all
cabal test all
bash test/scripts/run-all.sh
hlint app src test

format_tmp=$(mktemp -d)
trap 'rm -rf "$format_tmp"' EXIT

cp -R app src test "$format_tmp/"
mapfile -t haskell_files < <(find "$format_tmp" -name '*.hs' -print | sort)
ormolu --mode inplace "${haskell_files[@]}"
